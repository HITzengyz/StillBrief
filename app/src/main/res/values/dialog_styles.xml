<resources>
    <style name="MintDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#23796F</item>
        <item name="android:colorControlActivated">#23796F</item>
        <item name="android:colorControlHighlight">#C9E7D5</item>
        <item name="android:textColorPrimary">#244336</item>
        <item name="android:textColorSecondary">#6C8576</item>
        <item name="android:windowBackground">@drawable/mint_dialog_background</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MintDialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MintDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MintDialogButton</item>
    </style>
    <style name="MintDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/mint_dialog_button</item>
        <item name="android:textColor">#23796F</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MintDialogPositiveButton" parent="MintDialogButton">
        <item name="android:background">@drawable/mint_dialog_primary_button</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>

<resources>
    <style name="MintDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sb_accent</item>
        <item name="android:colorControlActivated">@color/sb_accent</item>
        <item name="android:colorControlHighlight">@color/sb_ripple</item>
        <item name="android:textColorPrimary">@color/sb_text</item>
        <item name="android:textColorSecondary">@color/sb_secondary</item>
        <item name="android:textColorHint">@color/sb_secondary</item>
        <item name="android:colorControlNormal">@color/sb_secondary</item>
        <item name="android:colorBackground">@color/sb_surface</item>
        <item name="android:windowBackground">@drawable/mint_dialog_background</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MintDialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MintDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MintDialogButton</item>
    </style>
    <style name="DurationSheetTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sb_accent</item>
        <item name="android:colorControlNormal">@color/sb_secondary</item>
        <item name="android:colorControlActivated">@color/sb_accent</item>
        <item name="android:colorControlHighlight">@color/sb_ripple</item>
        <item name="android:textColorPrimary">@color/sb_text</item>
        <item name="android:textColorSecondary">@color/sb_secondary</item>
        <item name="android:textColorHint">@color/sb_secondary</item>
        <item name="android:colorBackground">@color/sb_surface</item>
    </style>
</resources>
